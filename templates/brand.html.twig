{% set currentPage = 'brand' %}
{% extends "base.html.twig" %}
{% import "partials/_icons.html.twig" as icons %}
{% import "partials/_anchor-heading.html.twig" as anchor %}

{% block title %}Brand — {{ parent() }}{% endblock %}

{% block content %}
    {% include "partials/_page-header.html.twig" with {
        title: 'Brand',
        subtitle: 'Logotipas ir pagrindinės spalvos, kurios kuria MS identitetą.',
    } %}

    <section class="ds-section">
        {{ anchor.heading('h2', 'Logotipas', 'logotipas', 'ds-section__title') }}
        <div class="d-flex gap-ds-lg flex-wrap mb-ds-xl">
            <div class="logo-tile logo-tile--light">
                <span class="logo-tile__wordmark">
                    <span class="logo-tile__eyebrow">MOKESČIŲ</span>
                    <span class="logo-tile__word">SUFLERIS</span>
                </span>
            </div>
            <div class="logo-tile logo-tile--mid">
                <span class="logo-tile__wordmark">
                    <span class="logo-tile__eyebrow">MOKESČIŲ</span>
                    <span class="logo-tile__word">SUFLERIS</span>
                </span>
            </div>
            <div class="logo-tile logo-tile--dark">
                <span class="logo-tile__wordmark">
                    <span class="logo-tile__eyebrow">MOKESČIŲ</span>
                    <span class="logo-tile__word">SUFLERIS</span>
                </span>
            </div>
        </div>

        <a href="#" class="btn-ds-download">{{ icons.icon('download', 16) }} Atsisiųsti logotipus</a>
    </section>

    <a href="https://www.figma.com/design/ZkRyyI5TEHeg7IuUAz4HxW/?node-id=5684-5" target="_blank" rel="noopener noreferrer" class="ds-figma-link">{{ icons.icon('external-link', 14) }} Figmoje</a>
{% endblock %}
