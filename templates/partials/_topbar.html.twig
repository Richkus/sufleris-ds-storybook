            <path d="M17.2028 2.68359L15.543 4.85416" stroke="#284B4D" stroke-width="1.40448" stroke-linecap="round"/>
            <path d="M7.11609 2.68359L8.77593 4.85416" stroke="#284B4D" stroke-width="1.40448" stroke-linecap="round"/>
